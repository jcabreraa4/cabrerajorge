{
  "name": "cabrerajorge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n tailwind,wrangler -c \"#38bdf8,#f6821f\" \"tailwindcss -i src/globals.css -o public/styles.css --watch=always\" \"wrangler dev --port 3001 --live-reload\"",
    "build": "tailwindcss -i src/globals.css -o public/styles.css --minify",
    "lint": "biome lint",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm run build && wrangler deploy --minify",
    "typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "better-auth": "^1.7.25",
    "dotenv": "^18.0.10",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tailwindcss/cli": "^4.3.5",
    "concurrently": "^10.0.7",
    "drizzle-kit": "1.0.0-rc.5",
    "knip": "^6.45.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typed-htmx": "^0.3.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.164.0"
  }
}
