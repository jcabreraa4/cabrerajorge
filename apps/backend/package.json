{
  "name": "backend",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun db:start && trap 'bun db:stop' EXIT; tsx watch --env-file=.env.local src/index.ts",
    "build": "tsup && tsup && bunx drizzle-kit push",
    "start": "node dist/index.js",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose stop"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "better-auth": "^1.6.28",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6"
  }
}
