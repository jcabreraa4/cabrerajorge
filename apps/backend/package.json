{
  "name": "backend",
  "scripts": {
    "dev": "concurrently -n docker,server,studio -c blue,magenta,green \"docker compose up\" \"bun --hot src/index.ts\" \"bunx drizzle-kit studio\"",
    "build": "tsdown",
    "start": "bunx drizzle-kit push && bun dist/index.js",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/pg": "^8.23.1",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10",
    "tsdown": "^0.22.14",
    "typescript": "^6"
  }
}
