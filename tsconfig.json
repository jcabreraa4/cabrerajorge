{
  "compilerOptions": {
    // Language & Output
    "target": "ESNext",
    "lib": ["ESNext"],

    // Module Resolution
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/*"]
    },

    // Hono JSX
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",

    // Type Checking
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  }
}
